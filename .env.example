# 复制这个文件为 .env，填入你自己的配置
# 以智谱GLM为例（有免费额度）：https://open.bigmodel.cn
VITE_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VITE_API_KEY=你的APIKey
VITE_MODEL=glm-4-flash

# 如果换成通义千问 DashScope 兼容模式，改成：
# VITE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VITE_MODEL=qwen-turbo

# 如果换成 DeepSeek：
# VITE_API_BASE_URL=https://api.deepseek.com
# VITE_MODEL=deepseek-chat
